#!/usr/bin/env python3
import sys
import os
import subprocess
import json

# Ensure src module can be imported even when run via symlink
PROJECT_DIR = os.path.abspath(os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))
sys.path.insert(0, PROJECT_DIR)

from src.config import ConfigManager
from src.brain import get_verdict, daemon_is_up, resolve_display_ip
from src.integrity import cli_hook_status, repair, repair_cli
from src.network_guard import sync_hosts_file
from src.update_guard import apply_auto_update_lock

def print_help():
    help_text = """
ClaudeGuard CLI - VPN Whitelist & Auto-Update Control for Claude

Usage:
  claudeguard <command> [options]

Commands:
  status               Display current status, active IP, and whitelist
  set-ip-check-mode <auto|http|stun>  Select public-IP detection transport
  check                Run instant pre-flight IP check (Exit code 0=Allowed, 1=Blocked)
  add-ip <ip>          Add an IP or CIDR range to whitelist
  remove-ip <ip>       Remove an IP from whitelist
  list-ips             Show all whitelisted IPs
  enable-protection    Enable active network & pre-flight protection
  disable-protection   Disable protection (Traffic unblocked)
  block-updates        Enable auto-update locking (Desktop & CLI)
  allow-updates        Disable auto-update locking
  set-model <model>    Set the default model (e.g. claude-opus-4-8)
  enable-model         Enable model override for every claude session
  disable-model        Disable model override
  launch-desktop       Launch Claude Desktop with pre-flight IP verification
  start                Start ClaudeGuard Menu Bar App
  stop                 Stop ClaudeGuard Menu Bar App
  doctor               Check every hook is still attached, and re-attach it
  install-cli-wrapper  Install 'claude' CLI wrapper interceptor into PATH
  set-cli-path <path>  Set the real Claude CLI binary path ClaudeGuard launches
  uninstall            Uninstall ClaudeGuard LaunchAgent and wrappers
"""
    print(help_text.strip())

def main():
    if len(sys.argv) < 2:
        print_help()
        sys.exit(0)

    cmd = sys.argv[1].lower()
    config = ConfigManager()

    if cmd == "status":
        print("=== ClaudeGuard Status ===")
        print(f"Protection Enabled : {config.protection_enabled}")
        print(f"Block Auto-Updates : {config.block_auto_updates}")
        print(f"IP Check Mode      : {config.ip_check_mode}")
        if config.model_override_enabled:
            print(f"Default Model      : {config.default_model}")
        else:
            print(f"Default Model      : off")
        print(f"Whitelisted IPs    : {', '.join(config.allowed_ips) if config.allowed_ips else 'NONE (Access Blocked)'}")

        # Same verdict the wrapper and launcher enforce; show its source.
        up = daemon_is_up()
        print(f"Decision Source    : {'🧠 Daemon (live state.json)' if up else '🔌 Local check (daemon down)'}")
        print("\nPerforming IP check..." if not up else "")
        verdict, ip, err = get_verdict(config, timeout=2.0)
        # get_verdict returns ip=None when protection is off; show the real IP.
        if ip is None:
            ip = resolve_display_ip(config, timeout=2.0)
        print(f"Current Public IP  : {ip or 'OFFLINE/UNKNOWN'}")
        if not config.protection_enabled:
            print("Access Status      : 🟡 DISABLED (protection off)")
        elif verdict == "allowed":
            print("Access Status      : 🟢 ALLOWED (IP matches Whitelist)")
        elif verdict == "offline":
            print("Access Status      : ⚪ OFFLINE (IP can't be verified)")
        else:
            print("Access Status      : 🔴 BLOCKED (IP not in Whitelist)")
        if err:
            print(f"Error Details      : {err}")

    elif cmd == "set-ip-check-mode":
        if len(sys.argv) != 3 or sys.argv[2] not in ("auto", "http", "stun"):
            print("Usage: claudeguard set-ip-check-mode <auto|http|stun>")
            sys.exit(1)
        config.ip_check_mode = sys.argv[2]
        print(f"IP check mode: {config.ip_check_mode}. Daemon applies it on the next check.")

    elif cmd == "check":
        if not config.protection_enabled:
            sys.exit(0)
        verdict, ip, err = get_verdict(config, timeout=2.0)
        sys.exit(0 if verdict == "allowed" else 1)

    elif cmd in ("add-ip", "add"):
        if len(sys.argv) < 3:
            print("Error: Specify IP to add. Example: claudeguard add-ip 1.2.3.4")
            sys.exit(1)
        ip = sys.argv[2]
        config.add_ip(ip)
        print(f"✅ Added '{ip}' to allowed whitelist.")

    elif cmd in ("remove-ip", "rm-ip", "remove"):
        if len(sys.argv) < 3:
            print("Error: Specify IP to remove. Example: claudeguard remove-ip 1.2.3.4")
            sys.exit(1)
        ip = sys.argv[2]
        config.remove_ip(ip)
        print(f"✅ Removed '{ip}' from allowed whitelist.")

    elif cmd in ("list-ips", "ips"):
        print("Whitelisted IPs:")
        for ip in config.allowed_ips:
            print(f" - {ip}")

    elif cmd == "enable-protection":
        config.protection_enabled = True
        print("✅ Protection ENABLED.")

    elif cmd == "disable-protection":
        config.protection_enabled = False
        sync_hosts_file(block_claude_domains=False, block_update_domains=config.block_auto_updates, config=config)
        print("🟡 Protection DISABLED.")

    elif cmd == "block-updates":
        config.block_auto_updates = True
        apply_auto_update_lock(True)
        print("✅ Auto-updates BLOCKED.")

    elif cmd == "allow-updates":
        config.block_auto_updates = False
        apply_auto_update_lock(False)
        print("🟢 Auto-updates ALLOWED.")

    elif cmd == "set-model":
        if len(sys.argv) < 3:
            print("Error: Specify model ID. Example: claudeguard set-model claude-opus-4-8")
            sys.exit(1)
        model = sys.argv[2].strip()
        config.default_model = model
        if not config.model_override_enabled:
            config.model_override_enabled = True
        print(f"✅ Default model set to '{model}' (override enabled).")

    elif cmd == "enable-model":
        config.model_override_enabled = True
        print(f"✅ Model override ENABLED. Model: {config.default_model}")

    elif cmd == "disable-model":
        config.model_override_enabled = False
        print("🟡 Model override DISABLED.")

    elif cmd == "launch-desktop":
        launcher = os.path.join(PROJECT_DIR, "src", "app_launcher.py")
        os.execv(sys.executable, [sys.executable, launcher])

    elif cmd in ("start", "launch", "open"):
        plist = os.path.expanduser("~/Library/LaunchAgents/com.claudeguard.daemon.plist")
        app_path = os.path.expanduser("~/.local/share/ClaudeGuard/bin/ClaudeGuardMenuBar")
        subprocess.run(["launchctl", "load", plist], capture_output=True)
        if not os.system("pgrep -f ClaudeGuardMenuBar >/dev/null") == 0:
            subprocess.Popen([app_path])
        print("🚀 ClaudeGuard Menu Bar App launched.")

    elif cmd in ("stop", "quit", "close"):
        plist = os.path.expanduser("~/Library/LaunchAgents/com.claudeguard.daemon.plist")
        subprocess.run(["launchctl", "unload", plist], capture_output=True)
        subprocess.run(["pkill", "-f", "ClaudeGuardMenuBar"], check=False)
        print("🛑 ClaudeGuard Menu Bar App stopped.")

    elif cmd in ("doctor", "repair"):
        doctor(config)

    elif cmd == "install-cli-wrapper":
        report = repair_cli(config)
        for change in report["changed"]:
            print(f"✅ {change}")
        for note in report["notes"]:
            print(f"⚠️  {note}")
        if not report["changed"] and not report["notes"]:
            print("✅ 'claude' interceptor already installed and current.")

    elif cmd == "set-cli-path":
        if len(sys.argv) < 3:
            print("Error: Specify the real claude binary path. Example: claudeguard set-cli-path /opt/homebrew/bin/claude")
            sys.exit(1)
        path = os.path.realpath(sys.argv[2])
        if not os.path.isfile(path):
            print(f"Error: '{path}' does not exist or is not a file.")
            sys.exit(1)
        config.config["real_claude_cli_path"] = path
        config.save_config()
        print(f"✅ Real Claude CLI path set to '{path}'.")

    else:
        print(f"Unknown command: {cmd}")
        print_help()
        sys.exit(1)

def doctor(config):
    """Report on every hook ClaudeGuard owns, then re-attach whatever came loose.
    The command to run after Claude Code or Claude Desktop was reinstalled."""
    print("=== ClaudeGuard Doctor ===\n")

    report = repair(config)

    intercepted, hooks = cli_hook_status()
    print("Claude Code CLI")
    if hooks:
        for hook in hooks:
            mark = "🟢" if hook["guarded"] else "🔴"
            where = "" if hook["on_path"] else "  (not on your PATH)"
            what = "guarded by ClaudeGuard" if hook["guarded"] else "REAL binary — UNGUARDED"
            print(f"  {mark} {hook['path']} → {what}{where}")
    else:
        print("  ⚪ no 'claude' command found in any known bin directory")
    print(f"  Hands off to      : {report['real_cli'] or 'NOT FOUND'}")
    print(f"  Verdict           : {'🟢 intercepted' if intercepted else '🔴 NOT intercepted'}")

    print("\nClaude Desktop")
    if report["desktop_app"]:
        print(f"  🟢 {report['desktop_app']} (guarded by the menu bar daemon)")
    else:
        print("  ⚪ not installed")

    print("\nDaemon")
    print(f"  {'🟢 running' if daemon_is_up() else '🔴 NOT running — run: claudeguard start'}")

    print("\nWebsite blocking")
    print(f"  {'🟢 /etc/hosts writable by the root helper' if os.path.exists('/Library/LaunchDaemons/com.claudeguard.helper.plist') else '🔴 root helper missing — re-run install.sh'}")

    if report["changed"]:
        print("\nRepaired:")
        for change in report["changed"]:
            print(f"  ✅ {change}")
    if report["notes"]:
        print("\nNotes:")
        for note in report["notes"]:
            print(f"  ⚠️  {note}")
    if not report["changed"]:
        print("\n✅ Nothing to repair.")

if __name__ == "__main__":
    main()
